{
  "name": "trazo-3d",
  "version": "2.0.0",
  "description": "Modelador 3D de escritorio, local y en español",
  "author": "Trazo 3D",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supernero1/Trazo_3D.git"
  },
  "homepage": "https://github.com/supernero1/Trazo_3D#readme",
  "bugs": {
    "url": "https://github.com/supernero1/Trazo_3D/issues"
  },
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "build": "esbuild src/app.mjs --bundle --format=esm --platform=browser --outfile=src/app.bundle.js --minify",
    "smoke": "npm run build && node scripts/smoke.cjs",
    "prepare:examples": "node scripts/prepare-examples.mjs",
    "format": "prettier --write src scripts tests docs .github *.md package.json .prettierrc.json",
    "format:check": "prettier --check src scripts tests docs .github *.md package.json .prettierrc.json"
  },
  "build": {
    "appId": "local.trazo.modeler",
    "productName": "Trazo 3D",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/three/**/*",
      "node_modules/three-bvh-csg/**/*",
      "node_modules/three-mesh-bvh/**/*",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Trazo 3D",
      "artifactName": "Trazo3D-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Trazo3D-Portable-${version}.${ext}",
      "useZip": true
    },
    "npmRebuild": false
  },
  "dependencies": {
    "dxf-parser": "^1.1.2",
    "three": "^0.187.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
